gh-acc-swap() {
    local alt_dir="$HOME/.config/gh-alt"
    local alt_cfg="$alt_dir/gitconfig"
    local name email id default_email

    # 1. Log the alt account into its own isolated gh config dir (if needed).
    if ! GH_CONFIG_DIR="$alt_dir" gh auth status &>/dev/null; then
        echo "==> No alt account in $alt_dir — starting login."
        echo "    (pick HTTPS; the 'configure git credentials' prompt is fine to answer either way)"
        GH_CONFIG_DIR="$alt_dir" gh auth login --git-protocol https
    fi

    # 2. Build an isolated "global" gitconfig that inherits your real one, then
    #    overrides commit identity and disables GPG signing (signing with
    #    filip-rs's key would link the alt account to your main one).
    if [[ ! -f "$alt_cfg" ]]; then
        mkdir -p "$alt_dir"
        name=$(GH_CONFIG_DIR="$alt_dir" gh api user --jq .login 2>/dev/null)
        [[ -z "$name" ]] && name="alt-user"
        id=$(GH_CONFIG_DIR="$alt_dir" gh api user --jq .id 2>/dev/null)
        email=$(GH_CONFIG_DIR="$alt_dir" gh api user --jq .email 2>/dev/null)
        [[ "$email" == "null" ]] && email=""
        if [[ -z "$email" ]]; then
            email=$(GH_CONFIG_DIR="$alt_dir" gh api user/emails --jq '.[] | select(.primary==true) | .email' 2>/dev/null | head -1)
        fi
        if [[ -z "$email" ]]; then
            default_email="${id:+$id+}${name}@users.noreply.github.com"
            printf "Commit email for '%s' [enter = %s]: " "$name" "$default_email"
            read -r email
            [[ -z "$email" ]] && email="$default_email"
        fi
        cat > "$alt_cfg" <<EOF
[include]
    path = $HOME/.gitconfig

[user]
    name = $name
    email = $email

[commit]
    gpgsign = false
EOF
        echo "==> Wrote $alt_cfg  (name=$name  email=$email  gpgsign=false)"
    fi

    # Use whatever identity is actually in the file (lets you edit it later).
    name=$(git config --file "$alt_cfg" user.name)
    email=$(git config --file "$alt_cfg" user.email)

    echo "==> Entering alt-GitHub shell: $name <$email>"
    echo "    gh: $(GH_CONFIG_DIR="$alt_dir" gh api user --jq .login 2>/dev/null || echo "?")   — exit returns you to filip-rs"
    echo "    verify any time with:  gh auth status   /   git config user.email"

    GH_CONFIG_DIR="$alt_dir" \
    GIT_CONFIG_GLOBAL="$alt_cfg" \
    GIT_AUTHOR_NAME="$name"    GIT_AUTHOR_EMAIL="$email" \
    GIT_COMMITTER_NAME="$name" GIT_COMMITTER_EMAIL="$email" \
    GH_ACCOUNT=alt \
    POWERLEVEL9K_INSTANT_PROMPT=quiet \
    TMUX="${TMUX:-gh-alt-sandbox}" \
    command zsh -i
}

fuck () {
    TF_PYTHONIOENCODING=$PYTHONIOENCODING;
    export TF_SHELL=zsh;
    export TF_ALIAS=fuck;
    TF_SHELL_ALIASES=$(alias);
    export TF_SHELL_ALIASES;
    TF_HISTORY="$(fc -ln -10)";
    export TF_HISTORY;
    export PYTHONIOENCODING=utf-8;
    TF_CMD=$(
        thefuck THEFUCK_ARGUMENT_PLACEHOLDER $@
        ) && eval $TF_CMD;
        unset TF_HISTORY;
        export PYTHONIOENCODING=$TF_PYTHONIOENCODING;
        test -n "$TF_CMD" && print -s $TF_CMD
    }

