# ── Functions ────────────────────────────────────────────────────────
# Open a file / this folder in a GUI app and close the terminal (or tmux pane)
pdf() { setsid -f zathura "$@" >/dev/null 2>&1; exit; }
th() { setsid -f nautilus --new-window . >/dev/null 2>&1; exit; }

# Copy a file's contents, or the argument itself, to the clipboard
cpy() {
    if [[ -f $1 ]]; then wl-copy < "$1"; else print -rn -- "$1" | wl-copy; fi
}

# Toggle mouse side buttons MB5 -> W, MB4 -> S (keyd, for Inscryption)
mousews() {
	local f=/etc/keyd/mouse-ws.conf
	if [[ -e $f ]]; then
		sudo mv $f $f.off && sudo keyd reload && echo "mouse W/S: off"
	elif [[ -e $f.off ]]; then
		sudo mv $f.off $f && sudo keyd reload && echo "mouse W/S: on"
	else
		echo "mousews: neither $f nor $f.off exists" >&2
		return 1
	fi
}

