dnsfix() {
    sudo tee /etc/resolv.conf > /dev/null <<'EOF'
# Generated by NetworkManager
search home
nameserver 1.1.1.1
options edns0 trust-ad
EOF
}

# Davinci converter
conv() {
    if [ -z "$1" ]; then
        echo "Usage: conv inputfile [outputfile]"
        return 1
    fi

    input="$1"
    if [ -n "$2" ]; then
        output="$2"
    else
        base="${input%.*}"
        output="${base}.mov"
    fi

    ffmpeg -i "$input" -c:v prores_ks -profile:v 3 -c:a pcm_s16le "$output"
}

