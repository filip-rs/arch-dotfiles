# ~/.zshrc — plain zsh with plugins from the Arch repos/AUR, no framework.
#
# Kept fast on purpose: the completion dump is cached, and every plugin apart
# from the prompt loads right after the first prompt is drawn (zsh-defer).
# Profile startup by uncommenting the next line and running `zprof`.
#zmodload zsh/zprof

# ── Powerlevel10k instant prompt (keep at the top) ───────────────────
# Anything that may ask for input (passwords, [y/n]) must go above this.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet

# ── Environment ──────────────────────────────────────────────────────
typeset -U path  # no duplicate entries when shells nest (tmux, gh-acc-swap)
path=("$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/go/bin" $path /opt/miniconda3/bin)

export EDITOR=nvim
export BROWSER=librewolf
export GPG_TTY=$TTY
export NVM_DIR=/usr/share/nvm
# Default gh config dir, but keep an explicit override (gh-acc-swap relies on this).
export GH_CONFIG_DIR="${GH_CONFIG_DIR:-$HOME/.config/gh}"
# Flatpak apps for launchers, added in front of whatever the session already has
[[ ":$XDG_DATA_DIRS:" == *":/var/lib/flatpak/exports/share:"* ]] ||
  export XDG_DATA_DIRS="/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# ── History ──────────────────────────────────────────────────────────
HISTFILE=~/.zshhist
HISTSIZE=12000
SAVEHIST=10000
setopt INC_APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_SPACE HIST_IGNORE_ALL_DUPS \
       HIST_IGNORE_DUPS HIST_SAVE_NO_DUPS HIST_FIND_NO_DUPS

# ── Completion ───────────────────────────────────────────────────────
# A full rebuild of the dump (scanning every completion file) runs at most
# once a day; other shells load the cached one.
autoload -Uz compinit
() {
  setopt local_options extended_glob
  local dump=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump
  [[ -d ${dump:h} ]] || mkdir -p ${dump:h}
  if [[ -n $dump(#qN.mh-24) ]]; then compinit -C -d $dump; else compinit -d $dump; fi
}
# Case-insensitive, - and _ interchangeable, then partial-word matching
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]-_}={[:upper:][:lower:]_-}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ${XDG_CACHE_HOME:-$HOME/.cache}/zsh/compcache
zstyle ':completion:*:descriptions' format '[%d]'

# ── Machine-specific ─────────────────────────────────────────────────
case "$HOST" in
    arch*|KSAT*)
        alias update="paru -Syu && hyprpm update"
        alias refreshmirrors="rate-mirrors arch | sudo tee /etc/pacman.d/mirrorlist"
        alias pkgfnd="pacman -Q | grep"
        alias hyprconf="cd ~/.config/hypr && nvim hyprland.lua"

        source /usr/share/zsh/plugins/zsh-defer/zsh-defer.plugin.zsh

        # fzf-tab: Tab completion as a fuzzy-searchable list with previews.
        # Must load before plugins that wrap widgets (autosuggestions,
        # syntax highlighting); deferred sources run in the order queued.
        local_fzf_tab=(/usr/share/zsh/plugins/fzf-tab{,-git}/fzf-tab.plugin.zsh(N))
        if (( $#local_fzf_tab )); then
            zstyle ':completion:*' menu no
            zstyle ':fzf-tab:*' switch-group '<' '>'
            zstyle ':fzf-tab:complete:(cd|z|__zoxide_z):*' fzf-preview 'eza -1 --color=always --icons $realpath'
            zsh-defer source $local_fzf_tab[1]
        else
            zstyle ':completion:*' menu select
        fi
        unset local_fzf_tab

        zsh-defer source /usr/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
        zsh-defer source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
        zsh-defer source /usr/share/zsh/plugins/zsh-autopair/autopair.zsh
        zsh-defer source /usr/share/zsh/plugins/zsh-you-should-use/you-should-use.plugin.zsh
        zsh-defer source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
        zsh-defer source /usr/share/fzf/key-bindings.zsh  # Ctrl-R history, Ctrl-T files, Alt-C cd

        # Tab: accept the grey autosuggestion if there is one, otherwise complete.
        _accept_or_complete() {
            if [[ -n "$POSTDISPLAY" ]]; then
                zle autosuggest-accept
            elif (( $+widgets[fzf-tab-complete] )); then
                zle fzf-tab-complete
            else
                zle expand-or-complete
            fi
        }
        zle -N _accept_or_complete
        # Bound once the deferred plugins are in, since fzf-tab claims Tab on load
        zsh-defer -c 'bindkey "^I" _accept_or_complete'

        bindkey '^[[A' history-substring-search-up   # Up arrow
        bindkey '^[[B' history-substring-search-down # Down arrow
        bindkey '^K' history-substring-search-up     # ctrl k
        bindkey '^J' history-substring-search-down   # ctrl j

        case "$HOST" in
            archflipper)
                [[ -f ~/.fzf-git.sh ]] && zsh-defer source ~/.fzf-git.sh
                alias performance="sudo cpupower frequency-set -g performance"
                alias powersave="sudo cpupower frequency-set -g powersave"
                ;;
        esac
        ;;

    debian*|i5server)
        alias inst="sudo apt install"
        alias update="sudo apt update && sudo apt upgrade"
        zstyle ':completion:*' menu select
        ;;

    *)
        alias update="echo 'no system-specific update command defined'"
        zstyle ':completion:*' menu select
        ;;
esac

bindkey '^A' beginning-of-line
bindkey '^E' end-of-line

# ── Prompt ───────────────────────────────────────────────────────────
