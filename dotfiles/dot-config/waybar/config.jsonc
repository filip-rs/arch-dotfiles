// Waybar — two bar shapes across all outputs.
//
// Every module body lives in modules.jsonc and is pulled in with "include";
// these objects only decide layout. Options set here win over the include.
//
//   primary       eDP-1 (laptop) + DP-1 (desktop centre) — identical config
//   complementary DP-2 / DP-3 / HDMI-A-1 — per-output context only, no
//                 duplicated global controls
[
    {
        // ── PRIMARY: laptop panel and desktop centre monitor ──
        "name": "primary",
        "include": ["modules.jsonc"],
        "output": ["eDP-1", "DP-1"],
        "layer": "top",
        "position": "bottom",
        "mod": "dock",
        "exclusive": true,
        "passthrough": false,
        "gtk-layer-shell": true,
        "height": 0,

        "modules-left": [
            "clock",
            "custom/weather",
            "hyprland/workspaces"
        ],
        "modules-center": [
            "custom/os_button",
            "wlr/taskbar"
        ],
        "modules-right": [
            "custom/afk",
            "mpris",
            "custom/audio",
            "pulseaudio#microphone",
            // Merged tray pill (see style.css): the two custom indicators that
            // replaced tray apps, plus the real tray they sit next to. Caps are
            // mullvad and tray -- both always render, so the shape holds even
            // when caffeine self-hides on a machine without the binary.
            "custom/mullvad",
            "custom/hyprcaffeine",
            "tray",
            // One merged status pill (see style.css). The caps are network and
            // wlogout because those are the only two present on every machine:
            // backlight and battery drop out on the desktop, so making either
            // of them a cap would leave a square corner there. Order is fixed
            // -- changing it here without changing the border-radii there
            // breaks the shape.
            "network",
            "bluetooth",
            "backlight",
            "battery",
            "custom/wlogout"
        ]
    },
    {
        // ── COMPLEMENTARY: desktop side screens and the mirrored TV ──
        // backlight/battery/tray/audio deliberately absent: those live on the
        // primary bar only.
        "name": "complementary",
        "include": ["modules.jsonc"],
        "output": ["DP-2", "DP-3", "HDMI-A-1"],
        "layer": "top",
        "position": "bottom",
        "mod": "dock",
        "exclusive": true,
        "passthrough": false,
        "gtk-layer-shell": true,
        "height": 0,

        "modules-left": [
            "hyprland/workspaces"
        ],
        "modules-center": [
            "clock",
            "custom/weather"
        ],
        "modules-right": [
            "hyprland/window"
        ]
    }
]
