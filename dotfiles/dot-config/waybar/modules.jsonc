// Shared Waybar module definitions.
//
// Pulled into every bar in config.jsonc via "include". Waybar resolves a bare
// filename against $HOME/.config/waybar, so no absolute path is needed.
// Options set directly on a bar object take precedence over these.
//
// Generated from the pre-port config.jsonc, so every nerd-font glyph is byte
// identical to what was rendering before.
{
    "hyprland/window": {
        "format": "{}"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "[{name}: {windows}]",
        "on-click": "activate",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 5
        },
        "window-rewrite-default": "󱓻",
        "window-rewrite": {
            "title<.*youtube.*>": "",
            "class<firefox>": "",
            "class<none>": "r",
            "class<librewolf>": "󰈹",
            "class<librewolf> title<.*github.*>": "",
            "alacritty": "",
            "ghostty": "",
            "thunar": "󱧶",
            "code": "󰨞",
            "slack": "",
            "youtube-music": "󰎆",
            "notion": "",
            "title<.* - (.*) - VSCodium>": "codium $1"
        }
    },
    "clock": {
        "format": "{:%H:%M %b %e}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "~/.config/hypr/scripts/qs_manager.sh toggle calendar --anchor=left"
    },
    // Wi-Fi icon. Click opens the quickshell network panel in wifi mode.
    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "{ipaddr}",
        "tooltip-format": "{essid} — {ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "on-click": "~/.config/hypr/scripts/qs_manager.sh toggle network wifi --anchor=right"
    },
    // Bluetooth icon. Click opens the same panel in bluetooth mode.
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": " {num_connections}",
        "tooltip-format": "{device_alias}",
        "tooltip-format-connected": " {device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "~/.config/hypr/scripts/qs_manager.sh toggle network bt --anchor=right"
    },
    // Real output device, resolved through the Live EQ filter-chain.
    // See scripts/audio-device.sh — the built-in pulseaudio module cannot
    // see past that filter node and always showed a generic speaker.
    "custom/audio": {
        "exec": "~/.config/waybar/scripts/audio-device.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "~/.config/hypr/scripts/qs_manager.sh toggle volume --anchor=right",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%+",
        "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%-"
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "  {volume}%",
        "format-source-muted": "    Muted",
        "on-click": "~/.config/hypr/scripts/qs_manager.sh toggle volume --anchor=right",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
        "scroll-step": 5,
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "tooltip": true,
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{timeTo}  ({power}W)",
        "on-click": "~/.config/hypr/scripts/qs_manager.sh toggle battery --anchor=right"
    },
    "mpris": {
        "format": "{player_icon} <i>{title}</i>",
        "format-paused": "{status_icon} {title}",
        "player-icons": {
            "default": "⏸",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "▶"
        },
        "max-length": 45,
        "on-click": "~/.config/hypr/scripts/qs_manager.sh toggle music --anchor=left"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}   {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "min-length": 6
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10,
        "icons": {
            "steam": "$HOME/.local/share/icons/hicolor/16x16/apps/steam-waybar.png"
        }
    },
    "temperature": {
        "thermal-zone": 1,
        "format": "{temperatureC}°C ",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C "
    },
    "custom/weather": {
        "tooltip": true,
        "format": "{}",
        "interval": 30,
        "exec": "python ~/.config/waybar/scripts/waybar-wttr.py",
        "return-type": "json"
    },
    // Absolute-ish paths: waybar inherits Hyprland's PATH, which greetd starts
    // without ~/.local/bin. Self-hides on machines without the binary.
    "custom/afk": {
        "exec": "~/.local/bin/afk status --json",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.local/bin/afk toggle",
        "tooltip": true
    },
    "custom/power_profile": {
        "exec": "asusctl profile -p | sed s:'Active profile is'::",
        "interval": 30,
        "format": "󰈐{}",
        "on-click": "asusctl profile -n; pkill -SIGRTMIN+8 waybar",
        "signal": 8
    },
    // Left cap of the app dock; the taskbar is its right half.
    "custom/os_button": {
        "format": "󰍉",
        "on-click": "wofi --show drun",
        "tooltip": false
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 36,
        "spacing": 3,
        "on-click-middle": "close",
        "tooltip-format": "{title}",
        "ignore-list": [],
        "on-click": "activate"
    },
    "custom/wlogout": {
        "format": "{icon}",
        "on-click": "exec wlogout -b 5",
        "tooltip": false,
        "format-icons": [
            ""
        ]
    }
}
