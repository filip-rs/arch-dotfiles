# Calendar panel settings. Copy to .env (gitignored) and fill in.

# Weather location for Open-Meteo (no API key needed), and units.
# Find coordinates at https://open-meteo.com/en/docs (search a city).
WEATHER_LAT=
WEATHER_LON=
WEATHER_UNIT=metric        # or: imperial

# Calendar events: iCal (ICS) feed URLs, separated by spaces.
# Google Calendar: Settings -> pick the calendar -> "Secret address in iCal format".
# These URLs grant read access to the calendar, so keep them out of git.
CALENDAR_ICS_URLS=
